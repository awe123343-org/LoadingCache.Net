{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "semanticCommits": "enabled",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 6,
  "ignorePaths": [
    "**/artifacts/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "docs/research-evidence/**",
    "docs/benchmarks/**"
  ],
  "packageRules": [
    {
      "description": "Allow six hours for Maven mirror propagation before creating updates.",
      "matchDatasources": ["maven"],
      "minimumReleaseAge": "6 hours",
      "internalChecksFilter": "strict",
      "registryUrls": [
        "https://repo1.maven.org/maven2/",
        "https://maven-central.storage-download.googleapis.com/maven2/"
      ]
    },
    {
      "description": "Resolve Gradle plugin markers through the Plugin Portal.",
      "matchDatasources": ["maven"],
      "matchPackageNames": ["/\\.gradle\\.plugin$/"],
      "registryUrls": ["https://plugins.gradle.org/m2/"]
    },
    {
      "matchManagers": ["nuget"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Local package-validation fixtures are built by this repository, not published to NuGet.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "LoadingCache.LocalValidation",
        "LoadingCache.Extensions.DependencyInjection.LocalValidation"
      ],
      "enabled": false
    },
    {
      "description": "Allow Node major upgrades while preserving the major-only version format.",
      "matchManagers": ["nodenv"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Keep the net8.0 Microsoft.Extensions dependencies on the compatible 10.x line; newer targets upgrade independently.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Microsoft.Extensions.Caching.Memory",
        "Microsoft.Extensions.DependencyInjection",
        "Microsoft.Extensions.DependencyInjection.Abstractions",
        "Microsoft.Extensions.TimeProvider.Testing"
      ],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11"
    },
    {
      "description": "setup-dotnet also installs consumer runtimes; global.json independently controls the development SDK.",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["dotnet-sdk"],
      "matchCurrentVersion": "/^10\\./",
      "allowedVersions": "<11"
    }
  ]
}
