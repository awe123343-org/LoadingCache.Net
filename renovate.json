{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "semanticCommits": "enabled",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "prConcurrentLimit": 3,
  "ignorePaths": [
    "**/artifacts/**",
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    "docs/research-evidence/**",
    "docs/benchmarks/**"
  ],
  "packageRules": [
    {
      "matchManagers": ["nuget"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Local package-validation fixtures are built by this repository, not published to NuGet.",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "LoadingCache.LocalValidation",
        "LoadingCache.Extensions.DependencyInjection.LocalValidation"
      ],
      "enabled": false
    },
    {
      "description": "Allow Node major upgrades while preserving the major-only version format.",
      "matchManagers": ["nodenv"],
      "rangeStrategy": "replace"
    }
  ]
}
