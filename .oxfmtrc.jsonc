{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "tabWidth": 4,
  "arrowParens": "always",
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "proseWrap": "preserve",
  "overrides": [
    {
      "files": ["**/*.yml", "**/*.yaml"],
      "options": { "tabWidth": 2, "singleQuote": false },
    },
    {
      "files": ["**/*.json", "**/*.jsonc"],
      "options": { "tabWidth": 2 },
    },
  ],
  "ignorePatterns": [
    "**/bin/**",
    "**/obj/**",
    "artifacts/**",
    "node_modules/**",
    ".idea/**",
    "pnpm-lock.yaml",
    "docs/research-evidence/**",
    "docs/benchmarks/**/*.json",
    "docs/benchmarks/**/*.csv",
    "tools/LoadingCache.Simulator/results/**",
  ],
}
