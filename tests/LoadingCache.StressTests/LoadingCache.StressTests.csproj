<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FluentAssertions" PrivateAssets="all" />
    <PackageReference Include="TUnit" PrivateAssets="all" />
    <!-- TUnit 1.83.0 omits this dependency from its netstandard2.0 engine package. -->
    <PackageReference
      Include="Microsoft.Bcl.AsyncInterfaces"
      Condition="'$(TargetFramework)' == 'net8.0'"
      PrivateAssets="all"
    />

    <ProjectReference Include="../../src/LoadingCache/LoadingCache.csproj" />
  </ItemGroup>
</Project>
