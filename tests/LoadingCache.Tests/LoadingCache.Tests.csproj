<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- IDE0005 requires XML documentation processing, even in tests. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../../tools/LoadingCache.MemoryCacheProbe/ProbeCleanup.cs"
      Link="ProbeCleanup.cs"
    />
    <ProjectReference Include="../LoadingCache.AllocationProbe/LoadingCache.AllocationProbe.csproj" />
    <ProjectReference Include="../../src/LoadingCache/LoadingCache.csproj" />
    <!-- IDE-only annotations document generated record equality. -->
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="FluentAssertions" PrivateAssets="all" />
    <PackageReference Include="TUnit" PrivateAssets="all" />

    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" PrivateAssets="all" />
  </ItemGroup>
</Project>
